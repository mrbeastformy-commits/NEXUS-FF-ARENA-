      "title": "ArenaSongChunk",
      "description": "Raw binary base64 audio slice (~450 KB) under a song document.",
      "type": "object",
      "properties": {
        "songId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "index": { "type": "number" },
        "dataBase64": { "type": "string", "minLength": 1, "maxLength": 720000 },
        "sizeBytes": { "type": "number" }
      },
      "required": ["songId", "index", "dataBase64", "sizeBytes"]
    }
  },
