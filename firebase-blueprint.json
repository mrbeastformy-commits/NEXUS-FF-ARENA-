    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public player profile with zero PII (no email or phone).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "playerId": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "ffUid": { "type": "string", "minLength": 0, "maxLength": 32 },
        "inGameName": { "type": "string", "minLength": 2, "maxLength": 32 },
        "country": { "type": "string", "minLength": 2, "maxLength": 64 },
        "avatarUrl": { "type": "string", "minLength": 0, "maxLength": 1024 },
        "avatarImageId": { "type": "string", "maxLength": 128 },
        "balance": { "type": "number" },
        "matches": { "type": "number" },
        "wins": { "type": "number" },
        "eliminations": { "type": "number" },
        "mvpCount": { "type": "number" },
        "arenaPoints": { "type": "number" },
        "rank": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "banStatus": { "type": "string", "enum": ["none", "suspended", "banned"] },
        "chatRestricted": { "type": "boolean" },
        "tournamentRestricted": { "type": "boolean" },
        "banReason": { "type": "string", "maxLength": 500 },
        "banExpiresAt": { "type": "string", "maxLength": 64 },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "playerId", "inGameName", "country", "balance", "matches", "wins", "eliminations", "mvpCount", "arenaPoints", "rank", "isOnline", "banStatus", "chatRestricted", "tournamentRestricted", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
