# ==============================================================================
# NEXUS FF ARENA & NEXUS FF ADMIN — Environment Variables Checklist
# Copy this file to `.env` locally or configure these secrets in your cloud host.
# Never commit `.env` or real service account credentials to Git.
# ==============================================================================

# 1. REQUIRED FOR PRODUCTION & PUBLIC HTTPS LINK
# Full public HTTPS URL where the app is deployed (no trailing slash)
APP_URL="https://your-arena-domain.com"

# Comma-separated verified email address(es) allowed as Owner Admin
OWNER_ADMIN_ALLOWLIST="owner@example.com"

# Full JSON string of your Firebase Service Account (single-line JSON)
# Used by the Express server for verified Admin SDK operations
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Runtime mode & server port (Cloud hosts usually inject PORT automatically)
NODE_ENV="production"
PORT="3000"

# 2. OPTIONAL ENHANCEMENTS
# Gemini API Key (only needed if AI features are enabled)
GEMINI_API_KEY=""

# Optional Firebase App Check reCAPTCHA v3 / Enterprise site key
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# Optional Web Push VAPID key for Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY=""
