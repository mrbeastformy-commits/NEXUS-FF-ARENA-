# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_ADMIN_ALLOWLIST: Comma-separated verified Gmail addresses authorized as Owner Admin (server-side only).
OWNER_ADMIN_ALLOWLIST=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON string of Firebase Service Account for full Admin SDK transactions.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# VITE_FIREBASE_APP_CHECK_SITE_KEY: Optional reCAPTCHA v3 / Enterprise site key for Firebase App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# VITE_FIREBASE_VAPID_KEY: Optional Web Push VAPID key for Firebase Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=""
